<Page
    x:Class="Codux.WinUI.Views.AIStatsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Codux.WinUI.Views"
    Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="16,12" Background="{StaticResource SurfaceBrush}">
            <StackPanel Orientation="Horizontal">
                <SymbolIcon Symbol="ChartMultiple24" Margin="0,0,8,0" />
                <TextBlock Text="AI Usage Statistics"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Padding="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Summary Cards -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Level Card -->
                    <Border Grid.Column="0"
                            Background="{StaticResource SurfaceBrush}"
                            CornerRadius="8"
                            Padding="16"
                            Margin="4">
                        <StackPanel>
                            <TextBlock Text="Current Level"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding CurrentLevel}"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"
                                       Margin="0,8,0,0" />
                            <ProgressBar Value="{Binding LevelProgress}"
                                         Maximum="1"
                                         Height="4"
                                         Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Input Tokens Card -->
                    <Border Grid.Column="1"
                            Background="{StaticResource SurfaceBrush}"
                            CornerRadius="8"
                            Padding="16"
                            Margin="4">
                        <StackPanel>
                            <TextBlock Text="Input Tokens"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding TotalInputTokens, StringFormat='{}{0:N0}'}"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Output Tokens Card -->
                    <Border Grid.Column="2"
                            Background="{StaticResource SurfaceBrush}"
                            CornerRadius="8"
                            Padding="16"
                            Margin="4">
                        <StackPanel>
                            <TextBlock Text="Output Tokens"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding TotalOutputTokens, StringFormat='{}{0:N0}'}"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Model Breakdown -->
                <Border Grid.Row="1"
                        Background="{StaticResource SurfaceBrush}"
                        CornerRadius="8"
                        Padding="16"
                        Margin="4,16,4,4">
                    <StackPanel>
                        <TextBlock Text="Usage by Model"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12" />
                        
                        <ItemsControl ItemsSource="{Binding Summary.TokensByModel}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Key}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />

                                        <ProgressBar Grid.Column="1"
                                                     Value="{Binding Value}"
                                                     Maximum="1000"
                                                     Height="16"
                                                     Margin="8,0" />

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Value, StringFormat='{}{0:N0}'}"
                                                   FontSize="12"
                                                   Width="80"
                                                   TextAlignment="Right"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Recent Activity -->
                <Border Grid.Row="2"
                        Background="{StaticResource SurfaceBrush}"
                        CornerRadius="8"
                        Padding="16"
                        Margin="4,16,4,4">
                    <StackPanel>
                        <TextBlock Text="Recent Activity"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12" />

                        <ListView ItemsSource="{Binding RecentUsage}"
                                  MaxHeight="300"
                                  Background="Transparent"
                                  BorderThickness="0">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Timestamp, StringFormat='{}{0:MM/dd HH:mm}'}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Model}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource AccentBrush}" />

                                        <TextBlock Grid.Column="2"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}">
                                            <Run Text="{Binding InputTokens, StringFormat='{}{0:N0}'}" />
                                            <Run Text="in /" />
                                            <Run Text="{Binding OutputTokens, StringFormat='{}{0:N0}'}" />
                                            <Run Text="out" />
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="2"
              Background="#80000000"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
            <ProgressRing IsActive="True"
                          Width="40"
                          Height="40"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Page>
