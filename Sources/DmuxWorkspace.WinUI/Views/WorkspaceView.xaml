<Page
    x:Class="Codux.WinUI.Views.WorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Codux.WinUI.Views"
    Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="200" MaxWidth="400" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Projects Sidebar -->
        <Grid Grid.Column="0" Background="{StaticResource SurfaceBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Padding="16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Projects"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />

                <Button Grid.Column="1"
                        Content="+"
                        Width="28"
                        Height="28"
                        FontSize="16"
                        FontWeight="Bold"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Click="OnAddProjectClick"
                        ToolTipService.ToolTip="Add Project" />
            </Grid>

            <!-- Project List -->
            <ListView x:Name="ProjectsList"
                      Grid.Row="1"
                      ItemsSource="{x:Bind ViewModel.Projects}"
                      SelectedItem="{x:Bind ViewModel.SelectedProject, Mode=TwoWay}"
                      Background="Transparent"
                      BorderThickness="0"
                      SelectionChanged="OnProjectSelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <SymbolIcon Symbol="Folder24"
                                        Foreground="{StaticResource AccentBrush}"
                                        Margin="0,0,12,0" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}"
                                          FontSize="13"
                                          Foreground="{StaticResource TextPrimaryBrush}"
                                          TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Path}"
                                          FontSize="11"
                                          Foreground="{StaticResource TextSecondaryBrush}"
                                          TextTrimming="CharacterEllipsis"
                                          MaxWidth="180" />
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Content="X"
                                    Width="24"
                                    Height="24"
                                    FontSize="10"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Tag="{Binding}"
                                    Click="OnRemoveProjectClick"
                                    ToolTipService.ToolTip="Remove Project"
                                    Visibility="Visible" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Vertical Splitter -->
        <GridSplitter Grid.Column="1"
                      Width="1"
                      Background="{StaticResource BorderBrush}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Stretch" />

        <!-- Main Content Area -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <Grid Grid.Row="0" Padding="12,8" Background="{StaticResource SurfaceBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="+ New Terminal"
                            Command="{Binding NewTerminalPaneCommand}"
                            IsEnabled="{Binding SelectedProject, Converter={StaticResource NullToBoolConverter}}"
                            Padding="12,6"
                            Margin="0,0,8,0" />
                    <Button Content="Horizontal Split"
                            Click="OnSplitHorizontalClick"
                            IsEnabled="{Binding SelectedProject, Converter={StaticResource NullToBoolConverter}}"
                            Padding="12,6"
                            Margin="0,0,8,0" />
                    <Button Content="Vertical Split"
                            Click="OnSplitVerticalClick"
                            IsEnabled="{Binding SelectedProject, Converter={StaticResource NullToBoolConverter}}"
                            Padding="12,6" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="{Binding ActivePane.WorkingDirectory}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Visibility="{Binding ActivePane, Converter={StaticResource NullToVisibilityConverter}}" />
                </StackPanel>
            </Grid>

            <!-- Split View Container -->
            <Grid x:Name="SplitContainer" Grid.Row="1" Background="{StaticResource BackgroundBrush}">
                <!-- Empty State -->
                <StackPanel x:Name="EmptyState"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <SymbolIcon Symbol="WindowConsole20"
                                FontSize="64"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                HorizontalAlignment="Center" />
                    <TextBlock Text="No Terminals Open"
                               FontSize="18"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,16,0,0" />
                    <TextBlock Text="Select a project and click 'New Terminal' to get started"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
