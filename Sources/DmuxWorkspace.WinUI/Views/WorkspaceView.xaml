<Page
    x:Class="Codux.WinUI.Views.WorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Codux.WinUI.Views"
    Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Projects List -->
        <Grid Grid.Column="0" Background="{StaticResource SurfaceBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Padding="16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Projects"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />

                <Button Grid.Column="1"
                        Content="+"
                        Width="28"
                        Height="28"
                        FontSize="16"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnAddProjectClick" />
            </Grid>

            <!-- Project List -->
            <ListView x:Name="ProjectsList"
                      Grid.Row="1"
                      ItemsSource="{x:Bind ViewModel.Projects}"
                      SelectedItem="{x:Bind ViewModel.SelectedProject, Mode=TwoWay}"
                      Background="Transparent"
                      BorderThickness="0">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Name}"
                                          FontSize="13"
                                          Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding Path}"
                                          FontSize="11"
                                          Foreground="{StaticResource TextSecondaryBrush}"
                                          TextTrimming="CharacterEllipsis"
                                          MaxWidth="200" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="x"
                                    Width="20"
                                    Height="20"
                                    FontSize="10"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Tag="{Binding}"
                                    Click="OnRemoveProjectClick" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1"
                      Width="1"
                      Background="{StaticResource BorderBrush}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Stretch" />

        <!-- Terminal Panes -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <Grid Grid.Row="0" Padding="12,8" Background="{StaticResource SurfaceBrush}">
                <StackPanel Orientation="Horizontal">
                    <Button Content="+ New Terminal"
                            Click="OnNewTerminalClick"
                            Padding="12,6" />
                </StackPanel>
            </Grid>

            <!-- Terminal Content -->
            <Grid Grid.Row="1">
                <ListView x:Name="PanesList"
                          ItemsSource="{x:Bind ViewModel.Panes}"
                          SelectedItem="{x:Bind ViewModel.ActivePane, Mode=TwoWay}"
                          Background="Transparent"
                          BorderThickness="0">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1E1E1E"
                                    Padding="8"
                                    Margin="4"
                                    CornerRadius="4">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Tab Header -->
                                    <Grid Grid.Row="0" Background="#2D2D2D" Padding="8,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding WorkingDirectory}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />

                                        <Button Grid.Column="1"
                                                Content="x"
                                                Width="16"
                                                Height="16"
                                                FontSize="10"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Tag="{Binding}"
                                                Click="OnClosePaneClick" />
                                    </Grid>

                                    <!-- Terminal Output -->
                                    <ScrollViewer Grid.Row="1"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Auto">
                                        <TextBlock Text="{Binding TerminalOutput}"
                                                   FontFamily="Cascadia Code, Consolas"
                                                   FontSize="12"
                                                   Foreground="#CCCCCC"
                                                   TextWrapping="Wrap"
                                                   Margin="4" />
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Empty State -->
                <StackPanel x:Name="EmptyState"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock Text="No project selected"
                               FontSize="16"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Select a project or add a new one"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
