<Page
    x:Class="Codux.WinUI.Views.GitPanelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Codux.WinUI.Views"
    Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="16,12" Background="{StaticResource SurfaceBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <SymbolIcon Symbol="BranchFork24" Margin="0,0,8,0" />
                <TextBlock Text="{Binding CurrentBranch.Name, FallbackValue='No repository'}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Fetch" Command="{Binding FetchCommand}" Margin="4,0" Padding="8,4" />
                <Button Content="Pull" Command="{Binding PullCommand}" Margin="4,0" Padding="8,4" />
                <Button Content="Push" Command="{Binding PushCommand}" Margin="4,0" Padding="8,4" />
            </StackPanel>
        </Grid>

        <!-- Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Changes -->
            <Grid Grid.Column="0" Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Changes"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="8,8,8,4" />

                <ListView Grid.Row="1"
                          ItemsSource="{Binding Changes}"
                          Background="Transparent"
                          BorderThickness="0">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding Status}"
                                           FontSize="11"
                                           Width="60"
                                           Foreground="{StaticResource TextSecondaryBrush}" />

                                <TextBlock Grid.Column="1"
                                           Text="{Binding FilePath}"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource TextPrimaryBrush}" />

                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Content="+"
                                            Width="24"
                                            Height="24"
                                            Tag="{Binding}"
                                            Click="OnStageClick"
                                            Visibility="{Binding IsStaged, Converter={StaticResource InverseBoolToVisibility}}"
                                            Margin="2,0" />
                                    <Button Content="-"
                                            Width="24"
                                            Height="24"
                                            Tag="{Binding}"
                                            Click="OnUnstageClick"
                                            Visibility="{Binding IsStaged, Converter={StaticResource BoolToVisibility}}"
                                            Margin="2,0" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Commits -->
            <Grid Grid.Column="1" Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Commits"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="8,8,8,4" />

                <ListView Grid.Row="1"
                          ItemsSource="{Binding Commits}"
                          Background="Transparent"
                          BorderThickness="0">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding Sha}"
                                           FontFamily="Cascadia Code, Consolas"
                                           FontSize="11"
                                           Foreground="{StaticResource AccentBrush}" />

                                <TextBlock Grid.Column="1"
                                           Text="{Binding Message}"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource TextPrimaryBrush}" />

                                <TextBlock Grid.Column="2"
                                           Text="{Binding Date, StringFormat='{}{0:MM/dd}'}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Commit Message -->
                <Grid Grid.Row="2" Padding="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBox Grid.Row="0"
                             PlaceholderText="Commit message..."
                             Text="{Binding CommitMessage, Mode=TwoWay}"
                             Height="60"
                             TextWrapping="Wrap"
                             AcceptsReturn="True" />

                    <Button Grid.Row="1"
                            Content="Commit"
                            Command="{Binding CommitCommand}"
                            HorizontalAlignment="Right"
                            Margin="0,8,0,0"
                            Padding="16,8" />
                </Grid>
            </Grid>
        </Grid>

        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="2"
              Background="#80000000"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
            <ProgressRing IsActive="True"
                          Width="40"
                          Height="40"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Page>
