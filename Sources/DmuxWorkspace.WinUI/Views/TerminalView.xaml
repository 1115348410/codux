<Page
    x:Class="Codux.WinUI.Views.TerminalView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Codux.WinUI.Views"
    Background="#0C0C0C">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Grid Grid.Row="0" Height="32" Background="#1E1E1E">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Margin="8,0">
                <Ellipse Width="12" Height="12" Fill="#FF5F56" Margin="4,0" />
                <Ellipse Width="12" Height="12" Fill="#FFBD2E" Margin="4,0" />
                <Ellipse Width="12" Height="12" Fill="#27CA40" Margin="4,0" />
                <TextBlock Text="{Binding WorkingDirectory}"
                           Foreground="#CCCCCC"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0" />
            </StackPanel>

            <Button Grid.Column="1"
                    Content="X"
                    Width="46"
                    Height="32"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="12"
                    Click="OnCloseClick" />
        </Grid>

        <!-- Terminal Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Output -->
            <ScrollViewer x:Name="OutputScroller"
                          Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          Background="#0C0C0C"
                          Padding="8">
                <TextBlock x:Name="OutputText"
                           Text="{Binding TerminalOutput}"
                           FontFamily="Cascadia Code, Consolas, Courier New"
                           FontSize="13"
                           Foreground="#CCCCCC"
                           TextWrapping="Wrap" />
            </ScrollViewer>

            <!-- Input -->
            <Grid Grid.Column="0" VerticalAlignment="Bottom" Background="#1E1E1E">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text=">"
                           Foreground="#CCCCCC"
                           FontFamily="Cascadia Code, Consolas"
                           FontSize="13"
                           Margin="8,6" />

                <TextBox x:Name="InputBox"
                         Grid.Column="1"
                         Background="Transparent"
                         Foreground="#FFFFFF"
                         FontFamily="Cascadia Code, Consolas"
                         FontSize="13"
                         BorderThickness="0"
                         Margin="0,6"
                         KeyDown="OnInputKeyDown" />
            </Grid>
        </Grid>
    </Grid>
</Page>
