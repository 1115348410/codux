<Page
    x:Class="Codux.WinUI.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Codux.WinUI.Views"
    Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="16,12" Background="{StaticResource SurfaceBrush}">
            <StackPanel Orientation="Horizontal">
                <SymbolIcon Symbol="Settings24" Margin="0,0,8,0" />
                <TextBlock Text="Settings"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="24" MaxWidth="600" HorizontalAlignment="Left">

                <!-- Terminal Settings -->
                <TextBlock Text="Terminal"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,16" />

                <Border Background="{StaticResource SurfaceBrush}"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,0,24">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Shell"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding TerminalShell, Mode=TwoWay}"
                                     PlaceholderText="cmd.exe or powershell.exe" />
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Font Family"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding TerminalFontFamily, Mode=TwoWay}"
                                     PlaceholderText="Cascadia Code" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Font Size"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <NumberBox Grid.Column="1"
                                       Value="{Binding TerminalFontSize, Mode=TwoWay}"
                                       Minimum="8"
                                       Maximum="24" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Appearance Settings -->
                <TextBlock Text="Appearance"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,16" />

                <Border Background="{StaticResource SurfaceBrush}"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,0,24">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Dark Mode"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Use dark theme for the application"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsOn="{Binding DarkMode, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Startup Settings -->
                <TextBlock Text="Startup"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,16" />

                <Border Background="{StaticResource SurfaceBrush}"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,0,24">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Start Minimized"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Start in the system tray"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsOn="{Binding StartMinimized, Mode=TwoWay}" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Check for Updates"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Automatically check for updates on startup"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsOn="{Binding CheckForUpdates, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Save Button -->
                <Button Content="Save Settings"
                        Click="OnSaveClick"
                        Padding="24,12"
                        HorizontalAlignment="Left" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
