<Window x:Class="Codux.WinUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codux - Windows Terminal"
        Width="1460" Height="920"
        MinWidth="800" MinHeight="600"
        Background="#1E1E1E"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="200" MaxWidth="400"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>

        <!-- Sidebar -->
        <Grid Grid.Column="0" Grid.Row="0" Background="#252526">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Codux" FontSize="18" FontWeight="Bold"
                       Foreground="#FFFFFF" Margin="16,12"/>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="16,8">
                <Button Content="+ Add Project" Click="OnAddProject"
                        Padding="12,6" Margin="0,0,8,0"/>
            </StackPanel>

            <ListBox Grid.Row="2" x:Name="ProjectsList"
                     Background="Transparent" BorderThickness="0"
                     SelectionChanged="OnProjectSelected">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="8,6">
                            <TextBlock Text="{Binding Name}" FontSize="13"
                                       Foreground="#FFFFFF"/>
                            <TextBlock Text="{Binding Path}" FontSize="11"
                                       Foreground="#CCCCCC"
                                       TextTrimming="CharacterEllipsis" MaxWidth="240"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1" Width="1" Background="#3C3C3C"
                      HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

        <!-- Main Content -->
        <Grid Grid.Column="2" Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="12,8" Background="#252526">
                <Button Content="+ New Terminal" Click="OnNewTerminal"
                        Padding="12,6" Margin="0,0,8,0"/>
                <TextBlock x:Name="ProjectPathText" VerticalAlignment="Center"
                           Foreground="#CCCCCC" FontSize="12"/>
            </StackPanel>

            <!-- Terminals -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto" Background="#0C0C0C">
                <StackPanel x:Name="TerminalsContainer"/>
            </ScrollViewer>
        </Grid>

        <!-- Status Bar -->
        <Grid Grid.Column="2" Grid.Row="1" Background="#252526">
            <TextBlock x:Name="StatusText" Text="Ready" Foreground="#CCCCCC"
                       VerticalAlignment="Center" Margin="12,0"/>
        </Grid>
    </Grid>
</Window>
