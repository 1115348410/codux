<Window x:Class="Codux.WinUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codux"
        Width="1280"
        Height="800"
        MinWidth="960"
        MinHeight="600"
        Background="#0F0F0F">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#171717" BorderBrush="#2A2A2A" BorderThickness="0,0,1,0" Padding="12">
            <DockPanel>
                <Button DockPanel.Dock="Top"
                        Content="Add Project"
                        Margin="0,0,0,12"
                        Height="34"
                        Click="OnAddProject" />

                <ListBox x:Name="ProjectsList"
                         SelectionChanged="OnProjectSelected"
                         DisplayMemberPath="Name"
                         Background="#101010"
                         Foreground="#D0D0D0"
                         BorderBrush="#2A2A2A"
                         BorderThickness="1" />
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                <Button Content="New Terminal"
                        Width="120"
                        Height="34"
                        Click="OnNewTerminal" />
            </DockPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="TerminalsContainer" />
            </ScrollViewer>

            <Border Grid.Row="2" Margin="0,12,0,0" Padding="8" Background="#171717" BorderBrush="#2A2A2A" BorderThickness="1">
                <TextBlock x:Name="StatusText" Text="Ready" Foreground="#D0D0D0" />
            </Border>
        </Grid>
    </Grid>
</Window>
