<Window x:Class="Codux.WinUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codux"
        Width="1440" Height="900"
        MinWidth="960" MinHeight="640"
        Background="#151515"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBg" Color="#151515" />
        <SolidColorBrush x:Key="PanelBg" Color="#1E1E1E" />
        <SolidColorBrush x:Key="PanelBgSoft" Color="#232323" />
        <SolidColorBrush x:Key="BorderLine" Color="#343434" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F2F2F2" />
        <SolidColorBrush x:Key="TextSecondary" Color="#BBBBBB" />
        <SolidColorBrush x:Key="Accent" Color="#2B7FFF" />

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PanelBgSoft}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="200" MaxWidth="400"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>

        <Grid Grid.Column="0" Grid.Row="0" Background="{StaticResource PanelBg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="16,14,16,8">
                <TextBlock Text="Codux" FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="Windows Workspace" FontSize="11"
                           Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="16,8">
                <Button Content="Add Project" Click="OnAddProject" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>

            <ListBox Grid.Row="2" x:Name="ProjectsList"
                     Background="Transparent" BorderThickness="0"
                     SelectionChanged="OnProjectSelected">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#262626" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="6" Margin="8,6" Padding="10,8">
                            <StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="13"
                                       Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Path}" FontSize="11"
                                       Foreground="{StaticResource TextSecondary}"
                                        TextTrimming="CharacterEllipsis" MaxWidth="240"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <GridSplitter Grid.Column="1" Width="1" Background="{StaticResource BorderLine}"
                      HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

        <Grid Grid.Column="2" Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Margin="12,10,12,8" Padding="10,8" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderLine}" BorderThickness="1" CornerRadius="6">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Button Content="New Terminal" Click="OnNewTerminal" Style="{StaticResource PrimaryButton}"/>
                    </StackPanel>
                    <TextBlock x:Name="ProjectPathText"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Margin="12,0,12,8" Background="#0F0F0F" BorderBrush="{StaticResource BorderLine}" BorderThickness="1" CornerRadius="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              Background="Transparent">
                    <StackPanel x:Name="TerminalsContainer" Margin="6"/>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Column="2" Grid.Row="1" Background="{StaticResource PanelBg}">
            <TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource TextSecondary}"
                       VerticalAlignment="Center" Margin="12,0"/>
        </Grid>
    </Grid>
</Window>
